FROM node:22-alpine AS builder

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate

WORKDIR /workspace
COPY . .
RUN printf '\nnode-linker=hoisted\n' >> .npmrc

ARG API_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_LANDING_URL
ARG NEXT_PUBLIC_PWA_URL
ARG NEXT_PUBLIC_MERCHANT_URL
ARG NEXT_PUBLIC_CAJA_URL
ARG NEXT_PUBLIC_ORGANIZER_URL
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY

ENV API_URL=$API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_LANDING_URL=$NEXT_PUBLIC_LANDING_URL
ENV NEXT_PUBLIC_PWA_URL=$NEXT_PUBLIC_PWA_URL
ENV NEXT_PUBLIC_MERCHANT_URL=$NEXT_PUBLIC_MERCHANT_URL
ENV NEXT_PUBLIC_CAJA_URL=$NEXT_PUBLIC_CAJA_URL
ENV NEXT_PUBLIC_ORGANIZER_URL=$NEXT_PUBLIC_ORGANIZER_URL
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
ENV NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ENV NODE_ENV=production

RUN pnpm install --frozen-lockfile
RUN pnpm exec next build apps/merchant-dashboard

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0

COPY --from=builder /workspace/apps/merchant-dashboard/.next/standalone ./
COPY --from=builder /workspace/apps/merchant-dashboard/.next/static ./apps/merchant-dashboard/.next/static
COPY --from=builder /workspace/apps/merchant-dashboard/public ./apps/merchant-dashboard/public

EXPOSE 8080

CMD ["node", "apps/merchant-dashboard/server.js"]
