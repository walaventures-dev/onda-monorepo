{
  "name": "onda",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm exec nx run-many -t serve -p api,landing,pwa-client,merchant-dashboard,organizer-dashboard,pwa-caja --parallel=6",
    "predev": "bash scripts/ensure-dev-infra.sh",
    "dev:api": "bash scripts/ensure-dev-infra.sh && pnpm exec tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:landing": "pnpm exec next dev apps/landing -p 4200",
    "dev:pwa": "pnpm exec next dev apps/pwa-client -p 4201",
    "dev:merchant": "pnpm exec next dev apps/merchant-dashboard -p 4202",
    "dev:organizer": "pnpm exec next dev apps/organizer-dashboard -p 4203",
    "dev:caja": "pnpm exec next dev apps/pwa-caja -p 4204",
    "db:generate": "prisma generate --schema=libs/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=libs/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=libs/database/prisma/schema.prisma",
    "db:seed": "tsx libs/database/prisma/seed.ts",
    "db:studio": "prisma studio --schema=libs/database/prisma/schema.prisma",
    "docker:up": "docker compose up -d"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "^23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "^23.1.1",
    "@nx/next": "^23.1.1",
    "@nx/node": "^23.1.1",
    "@nx/react": "^23.1.1",
    "@nx/vite": "^23.1.1",
    "@nx/workspace": "23.1.1",
    "@prisma/engines": "^7.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "nx": "23.1.1",
    "postcss": "^8.5.25",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "dependencies": {
    "@google-cloud/tasks": "^7.0.0",
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@internationalized/date": "^3.12.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@onda/database": "workspace:*",
    "@onda/shared-types": "workspace:*",
    "@onda/shared-ui": "workspace:*",
    "@onda/shared-utils": "workspace:*",
    "@onda/wallets": "workspace:*",
    "@onda/whatsapp": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.22.0",
    "@zxing/browser": "^0.2.1",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.43.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "multer": "^2.2.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "nx",
      "prisma",
      "@prisma/engines",
      "@prisma/client",
      "sharp",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "prisma": {
    "seed": "tsx libs/database/prisma/seed.ts"
  }
}