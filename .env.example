DATABASE_URL="postgresql://onda:onda@localhost:5432/onda?schema=public"
# En Neon: DATABASE_URL = pooler, DIRECT_URL = host sin -pooler. En local pueden coincidir.
DIRECT_URL="postgresql://onda:onda@localhost:5432/onda?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="onda-dev-secret-change-me"
API_PORT=3333
NEXT_PUBLIC_API_URL="http://localhost:3333"

# Firebase Auth — merchant-dashboard (vacío = picker de sedes local)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Clave PEM; en .env usa \n para saltos de línea
FIREBASE_PRIVATE_KEY=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Google Cloud — Places (front) + Cloud Tasks (prod). Sin GCP_* = BullMQ/Redis local.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GCP_PROJECT=""
GCP_LOCATION="us-central1"
CLOUD_TASKS_QUEUE="onda-jobs"
JOBS_WORKER_URL="http://localhost:3333"
JOBS_SECRET=""
CLOUD_TASKS_SA_EMAIL=""
# Vacío = disco local (uploads/). En prod: bucket público GCS.
GCS_BUCKET=""

# Kapso — WhatsApp. Por ahora el OTP está mockeado en prod y en dev
# (código fijo 123456, visible en la PWA). OTP_MOCK=false para enviar por WhatsApp.
OTP_MOCK="true"
KAPSO_API_KEY=""
KAPSO_WEBHOOK_SECRET=""
KAPSO_PHONE_NUMBER_ID=""

# WalletWallet — https://www.walletwallet.dev/docs/
# Key format: ww_live_<32 hex>. Vacío o "dev-wallet-key" = modo stub.
WALLET_API_KEY=""
WALLET_API_BASE_URL="https://api.walletwallet.dev"
# free | trial | pro | byok — color, logo y strip de cartilla requieren trial/pro/byok
WALLET_PLAN="free"
# Alternativa explícita: WALLET_PRO=true

# Campañas — cupo gratis y precios extra (COP)
CAMPAIGN_FREE_MONTHLY=1
CAMPAIGN_PRICE_COP=29900
CAMPAIGN_PACK_SIZE=3
CAMPAIGN_PACK_DISCOUNT=0.15

WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_API_URL="https://sandbox.wompi.co/v1"

# Correo transaccional — remitente de plataforma (agnóstico al proveedor)
MAIL_FROM_EMAIL="hola@onda.lat"
MAIL_FROM_NAME="Onda"
# Brevo — proveedor actual. Vacío = stub (log). Remitente cae a MAIL_FROM_* si no hay BREVO_SENDER_*
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""
BREVO_SMS_SENDER="Onda"

NEXT_PUBLIC_MERCHANT_URL="http://localhost:4202"
NEXT_PUBLIC_LANDING_URL="http://localhost:4200"
NEXT_PUBLIC_PWA_URL="http://localhost:4201"
NEXT_PUBLIC_CAJA_URL="http://localhost:4204"
