# Postgres — Neon (recomendado) o Docker local. Docker solo se levanta si el host es localhost.
DATABASE_URL="postgresql://onda:onda@localhost:5432/onda?schema=public"
# En Neon: DATABASE_URL = pooler, DIRECT_URL = host sin -pooler. En local pueden coincidir.
DIRECT_URL="postgresql://onda:onda@localhost:5432/onda?schema=public"
# Redis local (BullMQ). Innecesario si GCP_PROJECT + CLOUD_TASKS_QUEUE están definidos.
REDIS_URL="redis://localhost:6379"
JWT_SECRET="onda-dev-secret-change-me"
API_PORT=3333
NEXT_PUBLIC_API_URL="http://localhost:3333"

# Firebase Auth — merchant-dashboard (vacío = picker de sedes local)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Clave PEM; en .env usa \n para saltos de línea
FIREBASE_PRIVATE_KEY=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Google Cloud — Places (front) + Cloud Tasks. Con GCP_PROJECT + CLOUD_TASKS_QUEUE no hace falta Redis/Docker.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server-side Place Details (onboarding snapshot, refresh). Puede coincidir con la pública.
GOOGLE_PLACES_API_KEY=""
GCP_PROJECT=""
GCP_LOCATION="us-central1"
CLOUD_TASKS_QUEUE="onda-jobs"
JOBS_WORKER_URL="http://localhost:3333"
JOBS_SECRET=""
CLOUD_TASKS_SA_EMAIL=""
# Vacío = disco local (uploads/). En prod: bucket público GCS.
GCS_BUCKET=""

# OTP WhatsApp — Meta Cloud API (login de clientes en la PWA)
# OTP_MOCK=true → código 123456 fijo, sin WhatsApp real (útil en dev).
# OTP_MOCK=false → envía la plantilla otp_template por Cloud API; requiere token + phone number ID.
OTP_MOCK="true"
# Token de System User con permiso whatsapp_business_messaging (permanente, no el de 24 h del Graph Explorer)
WHATSAPP_TOKEN=""
# Phone number ID numérico (WhatsApp Manager > API Setup), no el +57...
WHATSAPP_PHONE_NUMBER_ID=""
# Nombre exacto de la plantilla aprobada en WhatsApp Manager
WHATSAPP_OTP_TEMPLATE="otp_template"
# Código de idioma de la plantilla (debe coincidir exactamente con lo aprobado en Meta)
WHATSAPP_OTP_LANGUAGE="es"
# Versión de Graph API a usar
WHATSAPP_API_VERSION="v22.0"

# Kapso — WhatsApp para mensajes de negocio (bienvenida, invitaciones, código de caja)
# Vacío = stub (log). OTP ya no pasa por Kapso.
KAPSO_API_KEY=""
KAPSO_WEBHOOK_SECRET=""
KAPSO_PHONE_NUMBER_ID=""

# WalletWallet — https://www.walletwallet.dev/docs/
# Key format: ww_live_<32 hex>. Vacío o "dev-wallet-key" = modo stub.
WALLET_API_KEY=""
WALLET_API_BASE_URL="https://api.walletwallet.dev"
# free | trial | pro | byok — color, logo y strip de cartilla requieren trial/pro/byok
WALLET_PLAN="free"
# Alternativa explícita: WALLET_PRO=true

# Campañas — cupo gratis y precios extra (COP)
CAMPAIGN_FREE_REACH_MONTHLY=30
CAMPAIGN_REACH_PRICE_COP=200
CAMPAIGN_FREE_MONTHLY=30
CAMPAIGN_PRICE_COP=200
CAMPAIGN_PACK_SIZE=3
CAMPAIGN_PACK_DISCOUNT=0.15

WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_API_URL="https://sandbox.wompi.co/v1"

# Correo transaccional — remitente de plataforma (agnóstico al proveedor)
MAIL_FROM_EMAIL="hola@onda.lat"
MAIL_FROM_NAME="Onda"
# Brevo — proveedor actual. Vacío = stub (log). Remitente cae a MAIL_FROM_* si no hay BREVO_SENDER_*
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""
BREVO_SMS_SENDER="Onda"

NEXT_PUBLIC_MERCHANT_URL="http://localhost:4202"
NEXT_PUBLIC_LANDING_URL="http://localhost:4200"
NEXT_PUBLIC_PWA_URL="http://localhost:4201"
NEXT_PUBLIC_CAJA_URL="http://localhost:4204"

# Códigos promo de onboarding viven en Firestore (default) → colección `codes`.
# Cada doc ID = código (ej. DEMO2026) con discountPercentage, startDate, endDate.
