generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanType {
  BASIC
  PRO
}

enum EventStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TransactionType {
  ACCUMULATE
  REDEEM
}

enum PromotionType {
  PERCENT_OFF
  AMOUNT_OFF
  BUY_GET
  PRODUCT
  OTHER
}

enum PromotionExpiryMode {
  TIME
  QUANTITY
}

enum PromotionPool {
  BIENVENIDA
  RETENCION
}

enum PromotionIntent {
  GANCHO
  INTERMEDIA
  PREMIO
}

enum CartillaStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum CampaignChannel {
  SMS
  WALLET
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum CampaignOrigin {
  MANUAL
  RECOMMENDED
}

enum CampaignObjective {
  REACTIVATE
  SLOW_HOURS
  NEW_REWARD
  REVIEWS
}

enum CampaignBillingKind {
  FREE
  CREDIT
}

enum CampaignPurchaseSku {
  SINGLE
  PACK
  PACK_SUB
}

enum PendingRequestType {
  ACCUMULATE
  CLAIM
}

enum PendingRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum StoreMemberRole {
  ADMIN
  CAJA
}

enum StoreMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PosItemKind {
  PRODUCT
  SERVICE
}

enum PosTabStatus {
  OPEN
  CHECKOUT
  PAID
  VOID
}

enum PosSaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  VOID
}

enum PosRefundKind {
  FULL
  PARTIAL
  VOID_BEFORE_PAY
}

enum AccountingProvider {
  NONE
  ALEGRA
  SIIGO
}

enum AccountingSyncStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

enum StoreCategory {
  RESTAURANT
  SERVICE
  HOSPITALITY
}

enum StoreSubcategory {
  CAFE
  RESTAURANT_FULL
  BAR
  BAKERY
  FAST_FOOD
  FOOD_TRUCK
  RETAIL
  BEAUTY
  HEALTH
  AUTO
  EDUCATION
  OTHER_SERVICE
  HOTEL
  HOSTEL
  VACATION_RENTAL
  EVENT_VENUE
}

enum StoreSegment {
  CAFE_COFFEE
  CAFE_SPECIALTY
  CAFE_ROASTERY
  REST_CASUAL
  REST_FINE
  REST_TRADITIONAL
  REST_SEAFOOD
  BAR_PUB
  BAR_BREWERY
  BAR_COCKTAIL
  BAKERY_BREAD
  BAKERY_PASTRY
  BAKERY_DESSERT
  FAST_BURGER
  FAST_PIZZA
  FAST_CHICKEN
  FAST_OTHER
  TRUCK_FOOD
  TRUCK_CART
  RETAIL_FASHION
  RETAIL_BOUTIQUE
  RETAIL_MARKET
  RETAIL_OTHER
  BEAUTY_HAIR
  BEAUTY_BARBER
  BEAUTY_SALON
  BEAUTY_SPA
  BEAUTY_NAILS
  BEAUTY_BROWS
  HEALTH_CLINIC
  HEALTH_AESTHETIC
  HEALTH_PHARMA
  HEALTH_GYM
  HEALTH_DENTAL
  AUTO_SHOP
  AUTO_WASH
  AUTO_TIRES
  EDU_ACADEMY
  EDU_LANGUAGE
  EDU_TUTOR
  OTHER_PETS
  OTHER_CLEANING
  OTHER_GENERIC
  HOTEL_STANDARD
  HOTEL_BOUTIQUE
  HOSTEL_STANDARD
  STAY_CABIN
  STAY_GLAMPING
  STAY_APARTMENT
  VENUE_HALL
  VENUE_TERRACE
}

model Store {
  id                String                 @id @default(uuid())
  name              String
  slug              String                 @unique
  category          StoreCategory          @default(RESTAURANT)
  subcategory       StoreSubcategory
  segment           StoreSegment?
  googlePlaceId     String?
  address           String?
  planType          PlanType               @default(BASIC)
  billingStatus     String                 @default("ACTIVE")
  billingPeriod     String                 @default("monthly")
  whatsappUsed      Int                    @default(0)
  maxStamps         Int                    @default(12)
  currency          String                 @default("COP")
  ondaValue         Float?
  posEnabled        Boolean                @default(false)
  lat               Float?
  lng               Float?
  ownerName         String
  ownerEmail        String?
  referralCode      String                 @unique
  wompiTransactionId   String?
  wompiPaymentSourceId String?
  referredByStoreId String?
  freeMonthsBalance Int                    @default(1)
  referredBy        Store?                 @relation("StoreReferrals", fields: [referredByStoreId], references: [id])
  referrals         Store[]                @relation("StoreReferrals")
  passes            Pass[]
  transactions      Transaction[]
  feedbacks         Feedback[]
  promotions        Promotion[]
  cartillas         Cartilla[]
  eventMemberships  StoreEventMembership[]
  passDesign        PassDesign?
  pendingRequests   PendingRequest[]
  cajaLinks         CajaLink[]
  campaigns         Campaign[]
  campaignPurchases CampaignPurchase[]
  campaignCredits   Int                    @default(0)
  campaignPackSubscribed Boolean           @default(false)
  createdAt         DateTime               @default(now())
  members           StoreMember[]
  posItems          PosItem[]
  posAddons         PosAddon[]
  posTabs           PosTab[]
  posSales          PosSale[]
  posPaymentMethods PosPaymentMethodConfig[]
  accountingConfig  StoreAccountingConfig?

  @@index([ownerEmail])
}

model Campaign {
  id             String             @id @default(uuid())
  storeId        String
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  channel        CampaignChannel
  title          String
  status         CampaignStatus     @default(SCHEDULED)
  origin         CampaignOrigin     @default(MANUAL)
  objective      CampaignObjective?
  scheduledAt    DateTime?
  sentAt         DateTime?
  smsBody        String?
  walletBody     String?
  sendSms        Boolean            @default(true)
  sendWallet     Boolean            @default(true)
  audienceFilter Json?
  promoSnapshot  Json?
  billingKind    CampaignBillingKind @default(FREE)
  createdAt      DateTime           @default(now())

  @@index([storeId, channel, createdAt])
  @@index([storeId, status, scheduledAt])
}

model CampaignPurchase {
  id              String               @id @default(uuid())
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku             CampaignPurchaseSku
  credits         Int
  amountCop       Int
  wompiReference  String?              @unique
  createdAt       DateTime             @default(now())

  @@index([storeId, createdAt])
}

model Event {
  id           String                 @id @default(uuid())
  name         String
  slug         String                 @unique
  startDate    DateTime
  endDate      DateTime
  status       EventStatus            @default(DRAFT)
  globalTarget Int                    @default(10)
  stores       StoreEventMembership[]
  passes       Pass[]
  promotions   Promotion[]
  passDesign   PassDesign?
  draws        Draw[]
  createdAt    DateTime               @default(now())
}

model StoreEventMembership {
  id          String           @id @default(uuid())
  storeId     String
  eventId     String
  status      InvitationStatus @default(PENDING)
  customPromo String?
  nfcKitId    String?
  store       Store            @relation(fields: [storeId], references: [id])
  event       Event            @relation(fields: [eventId], references: [id])

  @@unique([storeId, eventId])
}

model User {
  id        String     @id @default(uuid())
  name      String
  phone     String     @unique
  passes    Pass[]
  feedbacks Feedback[]
  sessions  Session[]
  createdAt DateTime   @default(now())
}

model Pass {
  id           String        @id @default(uuid())
  userId       String
  storeId      String?
  eventId      String?
  cartillaId   String?
  serialNumber String        @unique
  points       Int           @default(0)
  cycleStartedAt DateTime    @default(now())
  pushToken    String?
  walletRef    String?
  user         User          @relation(fields: [userId], references: [id])
  store        Store?        @relation(fields: [storeId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])
  cartilla     Cartilla?     @relation(fields: [cartillaId], references: [id])
  transactions Transaction[]
  pendingRequests PendingRequest[]
  promoAssignments PassPromoAssignment[]
  posTabs       PosTab[]

  @@index([userId, storeId])
  @@index([userId, eventId])
  @@index([cartillaId])
}

model Transaction {
  id          String          @id @default(uuid())
  passId      String
  storeId     String
  type        TransactionType
  points      Int             @default(1)
  paymentAmount Int?
  /// Snapshot COP del beneficio otorgado en REDEEM (no cuenta como venta).
  benefitAmount Int?
  accumulateId String?
  promotionId String?
  cartillaId  String?
  createdAt   DateTime        @default(now())
  pass        Pass            @relation(fields: [passId], references: [id])
  store       Store           @relation(fields: [storeId], references: [id])
  promotion   Promotion?      @relation(fields: [promotionId], references: [id])
  cartilla    Cartilla?       @relation(fields: [cartillaId], references: [id])
  sourceAccumulate Transaction?  @relation("RedeemFromAccumulate", fields: [accumulateId], references: [id], onDelete: SetNull)
  linkedRedeems    Transaction[] @relation("RedeemFromAccumulate")

  @@index([storeId, createdAt])
  @@index([promotionId])
  @@index([cartillaId])
  @@index([accumulateId])
}

model Feedback {
  id                 String   @id @default(uuid())
  userId             String
  storeId            String
  rating             Int
  comment            String?
  redirectedToGoogle Boolean  @default(false)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
  store              Store    @relation(fields: [storeId], references: [id])
}

model Promotion {
  id               String               @id @default(uuid())
  storeId          String?
  eventId          String?
  title            String
  description      String?
  imageUrl         String?              @db.Text
  pointsRequired   Int
  isActive         Boolean              @default(true)
  type             PromotionType        @default(OTHER)
  value            Float?
  buyQuantity      Int?
  getQuantity      Int?
  productName      String?
  pool             PromotionPool        @default(RETENCION)
  intent           PromotionIntent      @default(INTERMEDIA)
  duplicatedFromId String?
  expiryMode       PromotionExpiryMode  @default(QUANTITY)
  endsAt           DateTime?
  maxRedemptions   Int?
  store            Store?               @relation(fields: [storeId], references: [id])
  event            Event?               @relation(fields: [eventId], references: [id])
  transactions     Transaction[]
  pendingRequests  PendingRequest[]
  cartillaItems    CartillaPromo[]
  assignments      PassPromoAssignment[]
  createdAt        DateTime             @default(now())

  @@index([storeId, pool])
}

model PassDesign {
  id              String  @id @default(uuid())
  storeId         String? @unique
  eventId         String? @unique
  cartillaId      String? @unique
  backgroundColor String  @default("#6E5AE6")
  foregroundColor String  @default("#FFFFFF")
  labelColor      String? @default("#E5F6FC")
  logoUrl         String?
  stripImageUrl   String?
  title           String
  subtitle        String?
  description     String?
  updatedAt       DateTime @updatedAt
  store           Store?  @relation(fields: [storeId], references: [id])
  event           Event?  @relation(fields: [eventId], references: [id])
  cartilla        Cartilla? @relation(fields: [cartillaId], references: [id])
}

model Cartilla {
  id            String         @id @default(uuid())
  storeId       String
  name          String
  isDefault     Boolean        @default(false)
  status        CartillaStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  maxStamps     Int            @default(12)
  smsRemindedAt DateTime?
  createdAt     DateTime       @default(now())
  store         Store          @relation(fields: [storeId], references: [id])
  passDesign    PassDesign?
  items         CartillaPromo[]
  passes        Pass[]
  transactions  Transaction[]
  assignments   PassPromoAssignment[]

  @@index([storeId, status])
}

model CartillaPromo {
  id             String         @id @default(uuid())
  cartillaId     String
  promotionId    String
  pointsRequired Int
  pool           PromotionPool
  cartilla       Cartilla       @relation(fields: [cartillaId], references: [id], onDelete: Cascade)
  promotion      Promotion      @relation(fields: [promotionId], references: [id])

  @@unique([cartillaId, pointsRequired, pool])
  @@index([promotionId])
}

model PassPromoAssignment {
  id             String    @id @default(uuid())
  passId         String
  cartillaId     String
  promotionId    String
  pointsRequired Int
  createdAt      DateTime  @default(now())
  pass           Pass      @relation(fields: [passId], references: [id], onDelete: Cascade)
  cartilla       Cartilla  @relation(fields: [cartillaId], references: [id])
  promotion      Promotion @relation(fields: [promotionId], references: [id])

  @@unique([passId, cartillaId, pointsRequired])
  @@index([promotionId, cartillaId])
}

model Lead {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  businessName String?
  message      String?
  createdAt    DateTime @default(now())
}

model Draw {
  id        String   @id @default(uuid())
  eventId   String
  winnerId  String?
  note      String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
}

model Session {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  code       String
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([phone])
}

model CajaLink {
  id         String    @id @default(uuid())
  token      String    @unique
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([storeId, revokedAt])
}

model PendingRequest {
  id          String               @id @default(uuid())
  type        PendingRequestType
  code        String
  passId      String
  storeId     String
  promotionId String?
  status      PendingRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?
  pass        Pass                 @relation(fields: [passId], references: [id])
  store       Store                @relation(fields: [storeId], references: [id])
  promotion   Promotion?           @relation(fields: [promotionId], references: [id])

  @@index([storeId, status])
  @@index([passId, status])
}

model StoreMember {
  id          String            @id @default(uuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email       String
  name        String
  role        StoreMemberRole
  status      StoreMemberStatus @default(PENDING)
  inviteToken String?           @unique
  invitedAt   DateTime          @default(now())
  acceptedAt  DateTime?
  revokedAt   DateTime?
  firebaseUid String?
  tabsOpened    PosTab[] @relation("PosTabOpenedBy")
  tabsAttending PosTab[] @relation("PosTabAttendedBy")

  @@unique([storeId, email])
  @@index([email, status])
}

model PosItem {
  id          String           @id @default(uuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind        PosItemKind
  name        String
  price       Int
  trackStock  Boolean          @default(false)
  stockQty    Int?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  externalSku String?
  imageUrl    String?          @db.Text
  variants    PosItemVariant[]
  addons      PosItemAddon[]
  tabLines    PosTabLine[]
  saleLines   PosSaleLine[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([storeId, isActive])
}

model PosAddon {
  id        String         @id @default(uuid())
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  price     Int            @default(0)
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  items     PosItemAddon[]
  tabLines  PosTabLineAddon[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([storeId, isActive])
}

model PosItemAddon {
  id        String   @id @default(uuid())
  itemId    String
  item      PosItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  addonId   String
  addon     PosAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)

  @@unique([itemId, addonId])
  @@index([addonId])
}

model PosItemVariant {
  id        String  @id @default(uuid())
  itemId    String
  item      PosItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@index([itemId])
}

model PosTab {
  id         String       @id @default(uuid())
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label      String
  status     PosTabStatus @default(OPEN)
  guestName  String?
  userId     String?
  passId     String?
  pass       Pass?        @relation(fields: [passId], references: [id])
  openedByMemberId    String?
  openedByMember      StoreMember? @relation("PosTabOpenedBy", fields: [openedByMemberId], references: [id], onDelete: SetNull)
  attendedByMemberId  String?
  attendedByMember    StoreMember? @relation("PosTabAttendedBy", fields: [attendedByMemberId], references: [id], onDelete: SetNull)
  openedAt   DateTime     @default(now())
  checkoutAt DateTime?
  lines      PosTabLine[]
  sale       PosSale?

  @@index([storeId, status])
  @@index([storeId, status, attendedByMemberId])
}

model PosTabLine {
  id          String            @id @default(uuid())
  tabId       String
  tab         PosTab            @relation(fields: [tabId], references: [id], onDelete: Cascade)
  itemId      String
  item        PosItem           @relation(fields: [itemId], references: [id])
  quantity    Int
  unitPrice   Int
  variantId   String?
  variantName String?
  addons      PosTabLineAddon[]

  @@index([tabId])
  @@index([itemId])
}

model PosTabLineAddon {
  id      String     @id @default(uuid())
  lineId  String
  line    PosTabLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  addonId String?
  addon   PosAddon?  @relation(fields: [addonId], references: [id], onDelete: SetNull)
  name    String
  price   Int        @default(0)

  @@index([lineId])
}

model PosSale {
  id            String            @id @default(uuid())
  storeId       String
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tabId         String            @unique
  tab           PosTab            @relation(fields: [tabId], references: [id])
  passId        String?
  subtotal      Int
  total         Int
  status        PosSaleStatus     @default(COMPLETED)
  completedAt   DateTime          @default(now())
  ondasGranted  Int               @default(0)
  loyaltyTxId   String?
  payments      PosPayment[]
  lines         PosSaleLine[]
  refunds       PosRefund[]
  accountingSync PosAccountingSync?

  @@index([storeId, completedAt])
  @@index([passId])
}

model PosSaleLine {
  id          String             @id @default(uuid())
  saleId      String
  sale        PosSale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId      String
  item        PosItem            @relation(fields: [itemId], references: [id])
  name        String
  quantity    Int
  unitPrice   Int
  variantName String?
  addons      PosSaleLineAddon[]

  @@index([saleId])
  @@index([itemId])
}

model PosSaleLineAddon {
  id     String      @id @default(uuid())
  lineId String
  line   PosSaleLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  name   String
  price  Int         @default(0)

  @@index([lineId])
}

model PosPayment {
  id           String  @id @default(uuid())
  saleId       String
  sale         PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  methodKey    String
  amount       Int
  cashReceived Int?
  changeGiven  Int?

  @@index([saleId])
}

model PosPaymentMethodConfig {
  id        String  @id @default(uuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key       String
  label     String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([storeId, key])
}

model PosRefund {
  id            String          @id @default(uuid())
  saleId        String
  sale          PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind          PosRefundKind
  reason        String?
  amount        Int
  ondasReversed Int             @default(0)
  lines         PosRefundLine[]
  createdAt     DateTime        @default(now())

  @@index([saleId])
}

model PosRefundLine {
  id        String    @id @default(uuid())
  refundId  String
  refund    PosRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  itemId    String
  quantity  Int
  unitPrice Int

  @@index([refundId])
}

model StoreAccountingConfig {
  storeId     String             @id
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider    AccountingProvider @default(NONE)
  credentials Json?
  autoSync    Boolean            @default(false)
  updatedAt   DateTime           @updatedAt
}

model PosAccountingSync {
  id         String               @id @default(uuid())
  saleId     String               @unique
  sale       PosSale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  provider   AccountingProvider
  status     AccountingSyncStatus @default(PENDING)
  externalId String?
  lastError  String?
  payload    Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}
