generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  BASIC
  PRO
}

enum EventStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TransactionType {
  ACCUMULATE
  REDEEM
}

enum PromotionType {
  PERCENT_OFF
  AMOUNT_OFF
  BUY_GET
  PRODUCT
  OTHER
}

enum PromotionExpiryMode {
  TIME
  QUANTITY
}

enum CampaignChannel {
  SMS
  WALLET
}

enum PendingRequestType {
  ACCUMULATE
  CLAIM
}

enum PendingRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum StoreCategory {
  RESTAURANT
  SERVICE
  HOSPITALITY
}

enum StoreSubcategory {
  CAFE
  RESTAURANT_FULL
  BAR
  BAKERY
  FAST_FOOD
  FOOD_TRUCK
  RETAIL
  BEAUTY
  HEALTH
  AUTO
  EDUCATION
  OTHER_SERVICE
  HOTEL
  HOSTEL
  VACATION_RENTAL
  EVENT_VENUE
}

model Store {
  id                String                 @id @default(uuid())
  name              String
  slug              String                 @unique
  category          StoreCategory          @default(RESTAURANT)
  subcategory       StoreSubcategory
  googlePlaceId     String?
  address           String?
  planType          PlanType               @default(BASIC)
  billingStatus     String                 @default("ACTIVE")
  whatsappUsed      Int                    @default(0)
  maxStamps         Int                    @default(12)
  lat               Float?
  lng               Float?
  ownerName         String
  ownerEmail        String?
  referralCode      String                 @unique
  wompiTransactionId   String?
  wompiPaymentSourceId String?
  referredByStoreId String?
  freeMonthsBalance Int                    @default(1)
  referredBy        Store?                 @relation("StoreReferrals", fields: [referredByStoreId], references: [id])
  referrals         Store[]                @relation("StoreReferrals")
  passes            Pass[]
  transactions      Transaction[]
  feedbacks         Feedback[]
  promotions        Promotion[]
  eventMemberships  StoreEventMembership[]
  passDesign        PassDesign?
  pendingRequests   PendingRequest[]
  campaigns         Campaign[]
  createdAt         DateTime               @default(now())

  @@index([ownerEmail])
}

model Campaign {
  id        String          @id @default(uuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  channel   CampaignChannel
  title     String
  createdAt DateTime        @default(now())

  @@index([storeId, channel, createdAt])
}

model Event {
  id           String                 @id @default(uuid())
  name         String
  slug         String                 @unique
  startDate    DateTime
  endDate      DateTime
  status       EventStatus            @default(DRAFT)
  globalTarget Int                    @default(10)
  stores       StoreEventMembership[]
  passes       Pass[]
  promotions   Promotion[]
  passDesign   PassDesign?
  draws        Draw[]
  createdAt    DateTime               @default(now())
}

model StoreEventMembership {
  id          String           @id @default(uuid())
  storeId     String
  eventId     String
  status      InvitationStatus @default(PENDING)
  customPromo String?
  nfcKitId    String?
  store       Store            @relation(fields: [storeId], references: [id])
  event       Event            @relation(fields: [eventId], references: [id])

  @@unique([storeId, eventId])
}

model User {
  id        String     @id @default(uuid())
  name      String
  phone     String     @unique
  passes    Pass[]
  feedbacks Feedback[]
  sessions  Session[]
  createdAt DateTime   @default(now())
}

model Pass {
  id           String        @id @default(uuid())
  userId       String
  storeId      String?
  eventId      String?
  serialNumber String        @unique
  points       Int           @default(0)
  cycleStartedAt DateTime    @default(now())
  pushToken    String?
  walletRef    String?
  user         User          @relation(fields: [userId], references: [id])
  store        Store?        @relation(fields: [storeId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])
  transactions Transaction[]
  pendingRequests PendingRequest[]

  @@index([userId, storeId])
  @@index([userId, eventId])
}

model Transaction {
  id          String          @id @default(uuid())
  passId      String
  storeId     String
  type        TransactionType
  points      Int             @default(1)
  promotionId String?
  createdAt   DateTime        @default(now())
  pass        Pass            @relation(fields: [passId], references: [id])
  store       Store           @relation(fields: [storeId], references: [id])
  promotion   Promotion?      @relation(fields: [promotionId], references: [id])

  @@index([storeId, createdAt])
  @@index([promotionId])
}

model Feedback {
  id                 String   @id @default(uuid())
  userId             String
  storeId            String
  rating             Int
  comment            String?
  redirectedToGoogle Boolean  @default(false)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
  store              Store    @relation(fields: [storeId], references: [id])
}

model Promotion {
  id             String               @id @default(uuid())
  storeId        String?
  eventId        String?
  title          String
  description    String?
  imageUrl       String?              @db.Text
  pointsRequired Int
  isActive       Boolean              @default(true)
  type           PromotionType        @default(OTHER)
  value          Float?
  buyQuantity    Int?
  getQuantity    Int?
  productName    String?
  expiryMode     PromotionExpiryMode  @default(QUANTITY)
  endsAt         DateTime?
  maxRedemptions Int?
  store          Store?               @relation(fields: [storeId], references: [id])
  event          Event?               @relation(fields: [eventId], references: [id])
  transactions   Transaction[]
  pendingRequests PendingRequest[]
  createdAt      DateTime             @default(now())
}

model PassDesign {
  id              String  @id @default(uuid())
  storeId         String? @unique
  eventId         String? @unique
  backgroundColor String  @default("#6E5AE6")
  foregroundColor String  @default("#FFFFFF")
  labelColor      String? @default("#E5F6FC")
  logoUrl         String?
  stripImageUrl   String?
  title           String
  subtitle        String?
  description     String?
  updatedAt       DateTime @updatedAt
  store           Store?  @relation(fields: [storeId], references: [id])
  event           Event?  @relation(fields: [eventId], references: [id])
}

model Lead {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  businessName String?
  message      String?
  createdAt    DateTime @default(now())
}

model Draw {
  id        String   @id @default(uuid())
  eventId   String
  winnerId  String?
  note      String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
}

model Session {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  code       String
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([phone])
}

model PendingRequest {
  id          String               @id @default(uuid())
  type        PendingRequestType
  code        String
  passId      String
  storeId     String
  promotionId String?
  status      PendingRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?
  pass        Pass                 @relation(fields: [passId], references: [id])
  store       Store                @relation(fields: [storeId], references: [id])
  promotion   Promotion?           @relation(fields: [promotionId], references: [id])

  @@index([storeId, status])
  @@index([passId, status])
}
