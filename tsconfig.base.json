{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@onda/shared/types": ["libs/shared/types/src/index.ts"],
      "@onda/shared-types": ["libs/shared/types/src/index.ts"],
      "@onda/shared/ui": ["libs/shared/ui/src/index.tsx"],
      "@onda/shared-ui": ["libs/shared/ui/src/index.tsx"],
      "@onda/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@onda/shared-utils": ["libs/shared/utils/src/index.ts"],
      "@onda/database": ["libs/database/src/index.ts"],
      "@onda/wallets": ["libs/wallets/src/index.ts"],
      "@onda/whatsapp": ["libs/whatsapp/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
